/* Platform support explanations */
"support.evidence.directMedia" = "A direct media address is confirmed to serve media before it is offered, then checksummed on the way into the archive.";
"support.evidence.x" = "Reads the public post payload that X publishes for embedded posts, keeping every photo and the highest-bitrate video the post exposes, in order.";
"support.evidence.reddit" = "Reads the post's own public JSON, which Reddit serves to anyone. A gallery keeps every image in the author's order. A Reddit-hosted video is saved as the file Reddit publishes, and the capture states plainly that Reddit stores its sound as a separate file it does not publish.";
"support.evidence.bluesky" = "Reads Bluesky's public API: the account identifier, then the post. Every attached picture is saved at full size. Video is published only as an adaptive playlist, so the poster frame is saved and labelled as such.";
"support.evidence.imgur" = "Resolves the public asset address for the post identifier and confirms the host serves it before saving.";
"support.evidence.tikTok" = "Saves the playable file when the public page publishes one. When it does not, the cover image is saved and the capture is labelled as cover-only rather than presented as the video.";
"support.evidence.pinterest" = "Reads the pin's own public widget payload for the original-size image or video rendition. Private and secret boards are not readable.";
"support.evidence.kick" = "Reads Kick's public clip endpoint. Saves the playable clip file when Kick publishes one. Many clips are published only as an adaptive stream, which is not a file; those are saved as the clip's poster frame, and the capture says so.";
"support.evidence.tumblr" = "Saves the media a public post publishes in its preview metadata. Posts behind a blog's content screen are not readable, and a post whose only published media is its preview image is labelled as such.";
"support.evidence.snapchat" = "Public Spotlight and Story links expose a preview image. Snapchat publishes no downloadable video address for a signed-out reader, so a Spotlight capture is the preview image and is labelled as one.";
"support.evidence.youTube" = "Saves the title, channel, and cover image that YouTube publishes through its own oEmbed endpoint. YouTube publishes no file address, so the video stream is not part of the capture.";
"support.evidence.instagram" = "A public post that still publishes preview metadata is saved. Instagram publishes one preview image per post, so a carousel is captured as its cover and said to be one. Most signed-out requests are answered with a login page, and those posts cannot be captured without an account, which Stashy never uses.";
"support.evidence.threads" = "Threads redirects signed-out readers to a login page, so only posts that still publish preview metadata can be saved, and those are labelled as preview-only captures.";
"support.evidence.discord" = "Discord support is bot-only and permission-scoped, and no bot token is configured. Stashy never automates a personal Discord account.";
"support.evidence.unverified" = "No live check completed for this build, so this description is what the adapter is written to do rather than what was last observed.";
"resolver.warning.previewOnly" = "This source published only its preview image for a signed-out reader, so that image was saved rather than the post's own media.";
"resolver.warning.kickNoVideo" = "Kick's clip record listed no video address, so the clip's poster frame was saved.";
