/* What each source gives */
"source.tikTok" = "Video without watermark at the highest bitrate the post page lists (up to 1080p), photo posts at full size, the caption and the author.";
"source.youTube" = "Video up to 4K with sound, muxed on your phone from YouTube's own streams. H.264 up to 1080p works everywhere; 1440p and 4K use AV1 and need an iPhone 15 Pro or newer.";
"source.instagram" = "Public posts, reels and carousels: every picture at full size and the video file. Stories and private accounts need a login Stashy does not have.";
"source.threads" = "Public posts: pictures at full size and the video file. Some posts are only served with a login.";
"source.x" = "Photos at original size and video at the highest MP4 rendition. Age-restricted posts need your own X API bearer token.";
"source.reddit" = "Images, galleries, GIFs and v.redd.it video with sound (video and audio are joined on your phone). Links to other sources are read with that source's reader.";
"source.bluesky" = "The original file the author uploaded — the true highest quality — plus the CDN copy as a fallback.";
"source.pinterest" = "The original image, every MP4 rendition of a video pin, and each page of an idea pin.";
"source.snapchat" = "Spotlight videos and public stories as MP4.";
"source.kick" = "Clips and past broadcasts. Kick serves them as stream segments; Stashy stitches them into one MP4 without re-encoding.";
"source.tumblr" = "Every picture block at full size, Tumblr-hosted video and audio. Reblogs keep the original blocks.";
"source.imgur" = "Images, albums and videos at original size.";
"source.discord" = "Attachments in a message your own bot can see. Needs a bot token you created; never a user token.";
"source.web" = "A direct image, video or audio link, or any public page's published video, pictures and metadata.";

