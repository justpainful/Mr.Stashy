<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Counts that vary at runtime. Without these, English read "1 item(s)" and Arabic used one
     accusative form for every number, which is only correct for 11-99. -->
<plist version="1.0">
<dict>
    <key>catch.ready.count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>تم العثور على %#@items@.</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
                <key>zero</key>
                <string>لا عناصر</string>
                <key>one</key>
                <string>عنصر واحد</string>
                <key>two</key>
                <string>عنصرين</string>
                <key>few</key>
                <string>%lld عناصر</string>
                <key>many</key>
                <string>%lld عنصرًا</string>
                <key>other</key>
                <string>%lld عنصر</string>
        </dict>
    </dict>
    <key>queue.itemCount</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
                <key>zero</key>
                <string>لا عناصر</string>
                <key>one</key>
                <string>عنصر واحد</string>
                <key>two</key>
                <string>عنصران</string>
                <key>few</key>
                <string>%lld عناصر</string>
                <key>many</key>
                <string>%lld عنصرًا</string>
                <key>other</key>
                <string>%lld عنصر</string>
        </dict>
    </dict>
    <key>library.mediaCount</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
                <key>zero</key>
                <string>لا عناصر</string>
                <key>one</key>
                <string>عنصر واحد</string>
                <key>two</key>
                <string>عنصران</string>
                <key>few</key>
                <string>%lld عناصر</string>
                <key>many</key>
                <string>%lld عنصرًا</string>
                <key>other</key>
                <string>%lld عنصر</string>
        </dict>
    </dict>
    <key>media.more</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
                <key>zero</key>
                <string>لا مزيد</string>
                <key>one</key>
                <string>عنصر إضافي</string>
                <key>two</key>
                <string>عنصران إضافيان</string>
                <key>few</key>
                <string>%lld إضافية</string>
                <key>many</key>
                <string>%lld إضافياً</string>
                <key>other</key>
                <string>%lld إضافي</string>
        </dict>
    </dict>
    <key>resolver.warning.partialMedia</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>تم حفظ %1$lld من %2$#@items@. لم يعد المصدر يقدّم البقية.</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
                <key>zero</key>
                <string>لا عناصر</string>
                <key>one</key>
                <string>عنصر واحد</string>
                <key>two</key>
                <string>عنصرين</string>
                <key>few</key>
                <string>%lld عناصر</string>
                <key>many</key>
                <string>%lld عنصرًا</string>
                <key>other</key>
                <string>%lld عنصر</string>
        </dict>
    </dict>
    <key>queue.partial</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>تم الاحتفاظ بـ %1$lld من %2$#@items@؛ لم يعد المصدر يقدّم البقية.</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
                <key>zero</key>
                <string>لا عناصر</string>
                <key>one</key>
                <string>عنصر واحد</string>
                <key>two</key>
                <string>عنصرين</string>
                <key>few</key>
                <string>%lld عناصر</string>
                <key>many</key>
                <string>%lld عنصرًا</string>
                <key>other</key>
                <string>%lld عنصر</string>
        </dict>
    </dict>
</dict>
</plist>
