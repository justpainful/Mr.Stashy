/* Platform support explanations */
"support.evidence.directMedia" = "يُتأكَّد من أن العنوان المباشر يقدّم وسائط فعلاً قبل عرضه، ثم تُحسب بصمته أثناء دخوله الأرشيف.";
"support.evidence.x" = "يقرأ حمولة المنشور العامة التي ينشرها إكس للمنشورات المضمّنة، ويحتفظ بكل صورة وبأعلى جودة فيديو يعرضها المنشور، بالترتيب.";
"support.evidence.reddit" = "يقرأ ملف JSON العام الخاص بالمنشور، وهو ما يقدّمه ريديت للجميع. يحتفظ المعرض بكل صورة بترتيب صاحب المنشور. يُحفظ فيديو ريديت كما ينشره، ويوضّح الحفظ صراحةً أن ريديت يخزّن الصوت في ملف منفصل لا ينشره.";
"support.evidence.bluesky" = "يقرأ واجهة بلوسكاي العامة: معرّف الحساب أولاً ثم المنشور. تُحفظ كل صورة مرفقة بحجمها الكامل. أما الفيديو فيُنشر كقائمة تشغيل متكيّفة فقط، لذلك تُحفظ صورته التمهيدية وتُوصف بذلك.";
"support.evidence.imgur" = "يستخرج العنوان العام للأصل من معرّف المنشور ويتأكد من أن المضيف يقدّمه قبل الحفظ.";
"support.evidence.tikTok" = "يحفظ الملف القابل للتشغيل عندما تنشره الصفحة العامة. وإن لم تنشره، تُحفظ صورة الغلاف ويوصَف الحفظ بأنه غلاف فقط بدل تقديمه كأنه الفيديو.";
"support.evidence.pinterest" = "يقرأ حمولة الودجت العامة للبِن للحصول على الصورة بحجمها الأصلي أو على نسخة الفيديو. اللوحات الخاصة والسرّية غير قابلة للقراءة.";
"support.evidence.kick" = "يقرأ نقطة المقاطع العامة في كيك. يحفظ ملف المقطع القابل للتشغيل عندما ينشره كيك. تُنشر مقاطع كثيرة كبثّ متكيّف لا كملف، وتلك تُحفظ كصورة تمهيدية مع توضيح ذلك.";
"support.evidence.tumblr" = "يحفظ الوسائط التي ينشرها المنشور العام في بيانات المعاينة. المنشورات خلف حاجز محتوى المدونة غير قابلة للقراءة، والمنشور الذي لا ينشر سوى صورة معاينة يوصَف بذلك.";
"support.evidence.snapchat" = "روابط سبوتلايت والقصص العامة تعرض صورة معاينة. لا ينشر سناب شات عنوان فيديو قابلاً للتنزيل لقارئ غير مسجَّل، لذلك يكون الحفظ هو صورة المعاينة ويوصَف بذلك.";
"support.evidence.youTube" = "يحفظ العنوان والقناة وصورة الغلاف التي ينشرها يوتيوب عبر نقطة oEmbed الخاصة به. لا ينشر يوتيوب عنوان ملف، لذلك لا يشمل الحفظ بثّ الفيديو.";
"support.evidence.instagram" = "يُحفظ المنشور العام الذي ما زال ينشر بيانات معاينة. ينشر إنستغرام صورة معاينة واحدة لكل منشور، لذلك يُحفظ المعرض كغلافه ويوضَّح ذلك. تُقابَل أغلب الطلبات غير المسجَّلة بصفحة تسجيل دخول، وتلك المنشورات لا يمكن حفظها دون حساب، وهو ما لا يستخدمه ستاشي أبداً.";
"support.evidence.threads" = "يحوّل ثريدز القارئ غير المسجَّل إلى صفحة تسجيل دخول، لذلك لا يمكن حفظ سوى المنشورات التي ما زالت تنشر بيانات معاينة، وتوصَف تلك بأنها حفظ معاينة فقط.";
"support.evidence.discord" = "دعم ديسكورد مقصور على البوتات ومقيَّد بالصلاحيات، ولا يوجد رمز بوت مهيَّأ. لا يشغّل ستاشي حساب ديسكورد شخصياً أبداً.";
"support.evidence.unverified" = "لم يكتمل فحص مباشر لهذا الإصدار، لذا يصف هذا النص ما بُني عليه المُحوِّل لا ما شوهد آخر مرة.";
"resolver.warning.previewOnly" = "لم ينشر هذا المصدر سوى صورة المعاينة لقارئ غير مسجَّل، لذلك حُفظت تلك الصورة بدل وسائط المنشور نفسه.";
"resolver.warning.kickNoVideo" = "لم يذكر سجل المقطع في كيك أي عنوان فيديو، لذلك حُفظت صورته التمهيدية.";
